{
  "manifest_version": 3,
  "name": "stugskill",
  "version": "1.0",
  "background": {
    "scripts": ["dist/bundle.js"]
  },
  "content_scripts": [
    {
      "matches": ["https://stug.io/*"],
      "js": ["dist/bundle.js"],
      "run_at": "document_start"
    }
  ],
  "permissions": [
    "storage"
  ]
}
